# ── TEMP ──────────────────────────────────────────────
tmp/
temp/
.tmp/

# ── WHAT STAYS IN (DO NOT IGNORE) ─────────────────────
# index.html       <- the entire app
# manifest.json    <- PWA config
# sw.js            <- service worker
# .nojekyll        <- GitHub Pages config
# .github/         <- GitHub Actions auto-deploy
# icon-192.svg     <- app icon
